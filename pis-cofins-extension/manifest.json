{
  "manifest_version": 3,
  "name": "Calculadora PIS / COFINS",
  "short_name": "PIS/COFINS",
  "description": "Calcule PIS e COFINS nos regimes de Lucro Presumido e Lucro Real de forma rápida e precisa.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Calculadora PIS / COFINS"
  },
  "permissions": ["storage"]
}
